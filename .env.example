# Telegram Bot
BOT_TOKEN=                        # dari @BotFather
AUTHORIZED_CHAT_IDS=              # comma-separated chat_id/group_id, contoh: 111,-100222,333
STORAGE_CHAT_ID=                  # ID group tempat file disimpan, format: -100xxxxxxxxxx
WEBHOOK_SECRET=                   # generate: openssl rand -hex 32

# Log
LOG_FILE=logs/app.log             # path file log, folder dibuat otomatis

# Server
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Database
# Local PostgreSQL
DATABASE_URL=postgresql://localhost:5432/tele_storage
# Neon (production): postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Redis (sessions)
REDIS_URL=redis://localhost:6379
# Production (Upstash, Railway, etc.): redis://default:<password>@<host>:<port>
