{
  "name": "tele-storage",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "db:push": "bunx drizzle-kit push",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.10.1"
  },
  "module": "src/index.js"
}
